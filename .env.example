# Copy this file to ".env" (or set these as Environment Variables in your
# hosting provider's dashboard — Render, Railway, etc.)

# Port the service listens on. Most hosts (Render, Railway) set this
# automatically — you usually don't need to touch it.
PORT=3000

# STRONGLY RECOMMENDED — without this, every ID card and cloud backup
# is lost whenever this service restarts (which free hosting tiers do
# often). See "MAKING DATA PERMANENT" in README-DEPLOY.md for the
# 5-minute, free fix using MongoDB Atlas.
# MONGODB_URI=mongodb+srv://REPLACE_WITH_USERNAME:REPLACE_WITH_PASSWORD@REPLACE_WITH_CLUSTER.mongodb.net/

# OPTIONAL — enables the Notice Board's "deliver by email" feature to send
# automatically from the server instead of opening the admin's own email
# client. Without these set, that feature still works via a mailto:
# fallback — this is purely an upgrade for hands-free delivery.
# Any standard SMTP provider works (Gmail app password, SendGrid, Mailgun,
# Amazon SES, Zoho, Outlook365, etc).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your-smtp-password-or-app-password
# SMTP_FROM=you@yourdomain.com

# OPTIONAL — enables server-side verification of Paystack online fee
# payments (Fees & Payments → "Pay online (Paystack)"). Without this,
# the popup still runs, but the app asks the admin to record the
# payment manually since it can't confirm it was genuine.
# Get this from your Paystack dashboard → Settings → API Keys & Webhooks.
# PAYSTACK_SECRET_KEY=REPLACE_WITH_YOUR_PAYSTACK_SECRET_KEY

# OPTIONAL — powers the Analytics page's "Ask your data" assistant with
# a real AI model instead of (or alongside) its built-in offline
# rule-based answers. Get a key from https://console.anthropic.com.
# ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
